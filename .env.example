# SQLite for local dev. Swap to a postgresql:// URL + provider="postgresql"
# in prisma/schema.prisma when moving to production.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# OAuth providers (optional — leave blank to disable Google/GitHub sign-in).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Shared secret the Mi Watch / Health Connect webhook sender must send
# in the `x-webhook-secret` header.
HEALTH_WEBHOOK_SECRET="change-me"
